<?php

/**
 * @file
 * Contains customisations for the webform date install.
 */

use Drupal\webform\Entity\Webform;

/**
 * Implements hook_update_dependencies().
 */
function bhcc_webform_date_update_dependencies() {

  // Update the localgov_forms_date after it has been installed.
  $dependencies['bhcc_webform_date'][8001] = [
    'localgov_forms_date' => 8002,
  ];

  return $dependencies;
}

/**
 * Implements hook_install().
 */
function bhcc_webform_date_install($is_syncing) {
  if (!$is_syncing) {
    _bhcc_webform_date_fix_date_config();
    _bhcc_webform_date_fix_date_time_config();
  }
}

/**
 * Update localgov_forms_date_short_date to BHCC format.
 *
 * Handle case where config imports before update which reverts the date
 * format change.
 */
function bhcc_webform_date_update_8001() {
  _bhcc_webform_date_fix_date_config();
  _bhcc_webform_date_fix_date_time_config();
}

/**
 * Implements hook_update_N().
 *
 * Ensure that date_min and date_max are not used.
 */
function bhcc_webform_date_update_10101(&$sandbox) {

  if (!isset($sandbox['total'])) {

    // Fetch all webform IDs.
    // $webforms = \Drupal::entityTypeManager()->getStorage('webform');
    $sandbox['webforms'] = array_values(\Drupal::service('entity_type.manager')
      ->getStorage('webform')
      ->getQuery()
      ->execute());
    $sandbox['total'] = count($sandbox['webforms']);
    $sandbox['current'] = 0;
  }

  // Loop through webforms, 10 at a time.
  $limit = 10;
  $max = $sandbox['current'] + $limit;
  for ($i = $sandbox['current']; $i < $max; $i++) {
    if (isset($sandbox['webforms'][$i])) {
      $webform = Webform::load($sandbox['webforms'][$i]);
      $elements = $webform->getElementsDecodedAndFlattened();

      foreach ($elements as $key => $element) {
        if (isset($element['#type']) && $element['#type'] === 'bhcc_webform_date') {

          if (isset($element['#date_max'])) {
            // Transfer '#date_max' to date_date_max and remove date_max.
            $elements[$key]['#date_date_max'] = $element['#date_max'];
            unset($elements[$key]['#date_max']);
            $webform->setElements($elements);
            $webform->save();
            \Drupal::logger('bhcc_webform_date')->notice('Updating the form:' . $webform->id() . ' element: ' . $element['#title'] . ' #date_date_max field');
          }

          // Transfer '#date_min' to date_date_min and remove date_min.
          if (isset($element['#date_min'])) {
            $elements[$key]['#date_date_min'] = $element['#date_min'];
            unset($elements[$key]['#date_min']);
            $webform->setElements($elements);
            $webform->save();
            \Drupal::logger('bhcc_webform_date')->notice('Updating the form:' . $webform->id() . ' element: ' . $element['#title'] . ' #date_date_min field');
          }
        }
      }
    }
    $sandbox['current']++;
  }
  // Check if update has finished.
  if ($sandbox['current'] >= $sandbox['total']) {
    $sandbox['#finished'] = 1;
  }
  else {
    $sandbox['#finished'] = ($sandbox['current'] / $sandbox['total']);
  }
}

/**
 * Helper function to set the localgov_forms_date_short_date config.
 */
function _bhcc_webform_date_fix_date_config() {
  $config_id = 'core.date_format.localgov_forms_date_short_date';
  $config = \Drupal::configFactory()->getEditable($config_id);
  $config->set('pattern', 'd/m/Y');
  $config->save();
}

/**
 * Helper function to set the localgov_forms_date_datetime config.
 */
function _bhcc_webform_date_fix_date_time_config() {
  $config_id = 'core.date_format.localgov_forms_date_datetime';
  $config = \Drupal::configFactory()->getEditable($config_id);
  $config->set('pattern', 'd/m/Y\TH:i:sO');
  $config->save();
}
